<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title"
        android:textColor="@color/accent"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/subtitle"
        android:textColor="@color/text_dim"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="16dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/accent"
        android:alpha="0.25"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ready"
        android:textColor="@color/cyan"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:padding="10dp"
        android:background="@drawable/bg_card"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnKillBg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/kill_bg"
        android:backgroundTint="@color/accent"
        android:textColor="#0A0616"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnCleanCache"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/clean_cache"
        android:backgroundTint="@color/mint"
        android:textColor="#0A1F14"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnTogglePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/start_panel"
        android:backgroundTint="@color/header"
        android:textColor="@color/text"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="tap a button to start."
        android:textColor="@color/text_dim"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:padding="10dp"
        android:background="@drawable/bg_card"/>

</LinearLayout>
